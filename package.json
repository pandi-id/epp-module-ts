{
    "name": "epp-ts",
    "version": "1.0.0",
    "description": "RFC-compliant EPP client for Node.js: domains, contacts, hosts, DNSSEC, RGP restores, ICANN sunrise and claims (TMCH), and registry fees",
    "keywords": [
        "epp",
        "rfc5730",
        "rfc5731",
        "rfc5732",
        "rfc5733",
        "rfc5734",
        "registrar",
        "registry",
        "domain",
        "icann",
        "dnssec",
        "tmch",
        "typescript"
    ],
    "license": "MIT",
    "author": "Ahmad Ropai",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/teknispandi/epp-module-ts.git"
    },
    "homepage": "https://github.com/teknispandi/epp-module-ts#readme",
    "bugs": {
        "url": "https://github.com/teknispandi/epp-module-ts/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\" --fix",
        "example:basic": "ts-node examples/basic-usage.ts",
        "example:tls": "ts-node examples/tls-tcp-connection.ts",
        "example:ssl": "ts-node examples/ssl-configurations.ts",
        "example:domain": "ts-node examples/complete-domain-registration.ts",
        "example:transfer": "ts-node examples/domain-transfer.ts",
        "example:dnssec": "ts-node examples/dnssec-operations.ts",
        "example:extensions": "ts-node examples/epp-extensions.ts",
        "example:poll": "ts-node examples/poll-queue.ts",
        "example:all": "ts-node examples/run-all-examples.ts",
        "prepack": "npm run build",
        "prepublishOnly": "npm run lint && npm run typecheck && npm test"
    },
    "dependencies": {
        "sax": "^1.4.1"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@types/node": "^18.19.130",
        "@types/sax": "^1.2.7",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "jest": "^29.5.0",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.0",
        "typescript": "^5.0.0",
        "xmllint-wasm": "^5.3.0"
    }
}
